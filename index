<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>IN-$ight</title>

<style>
body {
  font-family: Arial, sans-serif;
  margin: 0;
  background: #111;
  color: white;
}

header {
  display: flex;
  justify-content: space-between;
  padding: 20px;
  background: #000;
}

button {
  padding: 10px 15px;
  background: #ff2d55;
  border: none;
  color: white;
  cursor: pointer;
}

.hero {
  text-align: center;
  padding: 40px;
}

.carousel-container {
  position: relative;
  padding: 20px;
}

.carousel {
  display: flex;
  overflow-x: auto;
  gap: 15px;
}

.card {
  min-width: 250px;
  background: #222;
  padding: 10px;
  border-radius: 10px;
  text-align: center;
}

.card img {
  width: 100%;
  border-radius: 10px;
}

.prev, .next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}

.prev { left: 0; }
.next { right: 0; }
</style>

</head>
<body>

<header>
  <h1>IN-$ight</h1>
  <button onclick="subscribe()">Subscribe ($80/year)</button>
</header>

<section class="hero">
  <h2>Exclusive Content from Top Influencers</h2>
  <p>Unlock premium content for just $80/year per influencer</p>
</section>

<section class="carousel-container">
  <h2>Featured Influencers</h2>
  
  <div class="carousel" id="carousel"></div>

  <button class="prev" onclick="scrollCarousel(-1)">❮</button>
  <button class="next" onclick="scrollCarousel(1)">❯</button>
</section>

<script>
const BTC_WALLET = "1LLrDALnEcKsvWp67fb3uU7BSFeFjpx7xV";

const influencers = [
  { name: "Luna Virelle", img: "https://picsum.photos/300/400?random=1" },
  { name: "Zara Nyx", img: "https://picsum.photos/300/400?random=2" },
  { name: "Elara Voss", img: "https://picsum.photos/300/400?random=3" },
  { name: "Nyomi Kade", img: "https://picsum.photos/300/400?random=4" },
  { name: "Sienna Vale", img: "https://picsum.photos/300/400?random=5" },
  { name: "Aria Solene", img: "https://picsum.photos/300/400?random=6" }
];

const carousel = document.getElementById("carousel");

// Create cards
influencers.forEach(influencer => {
  const card = document.createElement("div");
  card.className = "card";

  card.innerHTML = `
    <img src="${influencer.img}">
    <h3>${influencer.name}</h3>
    <button onclick="unlock('${influencer.name}')">Unlock ($80/year)</button>
  `;

  carousel.appendChild(card);
});

// Scroll
function scrollCarousel(direction) {
  carousel.scrollBy({
    left: direction * 300,
    behavior: 'smooth'
  });
}

// Payment alerts
function subscribe() {
  alert(
    "Subscribe for $80/year\n\n" +
    "Send Bitcoin to:\n" +
    BTC_WALLET +
    "\n\nAccess granted after payment."
  );
}

function unlock(name) {
  alert(
    "Unlock " + name + " for $80/year\n\n" +
    "Send Bitcoin to:\n" +
    BTC_WALLET +
    "\n\nUse your name as reference."
  );
}
</script>

</body>
</html>
